#!/usr/bin/env python3
# SPDX-FileCopyrightText: OmidenOS project
# SPDX-License-Identifier: BSD-3-Clause
"""Repository style checks that are automatable.

Enforced rules (engineering standards, section 13):
- no work-item markers in tracked files (items belong to
  docs/BACKLOG.md)
- no emoji anywhere
- no marketing vocabulary in user-facing documents
"""

from __future__ import annotations

import re
import subprocess
import sys

MARKER_RE = re.compile(r"\b(TODO|FIXME|HACK|XXX)\b")
# Only code points from the emoji blocks; symbols like plain ASCII or
# typographic characters are not flagged.
EMOJI_RE = re.compile(
    "[\U0001F300-\U0001FAFF\U00002700-\U000027BF\U0001F000-\U0001F0FF]"
)
MARKETING_RE = re.compile(
    r"\b(ultimate|blazing|next-gen|powerful|seamless|revolutionary)\b",
    re.IGNORECASE,
)

SKIP_DIRS = (".git", "out", "work", "build")
# The checker itself must contain the marker words as regex patterns, and
# test files embed them as fixtures; both are excluded from this scan.
SKIP_FILES = ("scripts/lint-style",)


def tracked_files() -> list[str]:
    # `safe.directory=*` keeps the listing usable in a container or on a
    # bind-mounted checkout, where git refuses the repository because the
    # directory is owned by another user (CI steps run as root).
    try:
        out = subprocess.run(
            ["git", "-c", "safe.directory=*", "ls-files"],
            capture_output=True,
            text=True,
            check=True,
        )
    except FileNotFoundError:
        print("lint-style: FAILED: git is not installed")
        sys.exit(1)
    except subprocess.CalledProcessError as exc:
        detail = (exc.stderr or "").strip() or f"exit status {exc.returncode}"
        print(f"lint-style: FAILED: cannot list tracked files: {detail}")
        sys.exit(1)
    files = []
    for line in out.stdout.splitlines():
        if any(part in line.split("/") for part in SKIP_DIRS):
            continue
        if line.endswith((".md", ".sh", ".py", ".toml", ".yml", ".yaml",
                          ".conf", ".service", ".desktop", ".cfg")) \
                or line == "Makefile":
            files.append(line)
    return files


def main() -> int:
    failures = []
    for path in tracked_files():
        if path.startswith("tests/") or path in SKIP_FILES:
            continue
        try:
            with open(path, encoding="utf-8") as fh:
                content = fh.read()
        except (OSError, UnicodeDecodeError):
            continue
        for lineno, line in enumerate(content.splitlines(), start=1):
            checks = (
                ("TODO/FIXME marker", MARKER_RE.search(line)),
                ("emoji", EMOJI_RE.search(line)),
                ("marketing word", MARKETING_RE.search(line)),
            )
            for label, match in checks:
                if match:
                    failures.append(f"{path}:{lineno}: {label}: {line.strip()}")
    if failures:
        print("lint-style: FAILED")
        for failure in failures:
            print(f"  {failure}")
        return 1
    print("lint-style: OK")
    return 0


if __name__ == "__main__":
    sys.exit(main())
