#!/usr/bin/env python3
# SPDX-FileCopyrightText: OmidenOS project
# SPDX-License-Identifier: BSD-3-Clause
"""Brand scan for OmidenOS.

Scans first-party files for third-party distribution names and marks
allowlisted occurrences (documented upstream references). Modes:

strict  - first-party product sources (default scope)
        (image/runtime/screens modes are added in later phases)
"""

from __future__ import annotations

import argparse
import re
import sys
import tomllib
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent

DEFAULT_STRICT_SCOPE = (
    "archiso",
    "packages",
    "calamares",
    "branding/source",
    "ctl",
    "tools",
)

FORBIDDEN_TERMS_FILE = "branding/forbidden-terms.toml"
ALLOWLIST_FILE = "branding/upstream-allowlist.toml"


def compile_patterns(terms: list[dict]) -> list[tuple[str, re.Pattern]]:
    compiled = []
    for term in terms:
        pattern = re.compile(
            term["pattern"],
            re.IGNORECASE if term.get("case_insensitive", True) else 0,
        )
        compiled.append((term["id"], pattern))
    return compiled


def load_toml(path: Path) -> dict:
    with open(path, "rb") as fh:
        return tomllib.load(fh)


def is_text_file(path: Path) -> bool:
    """Follow git's convention: a NUL byte in the first 8 KiB means binary."""
    try:
        with open(path, "rb") as fh:
            return b"\0" not in fh.read(8192)
    except OSError:
        return False


def scan_file(
    path: Path,
    patterns: list[tuple[str, re.Pattern]],
    allowlist: list[dict],
) -> tuple[list[tuple[str, int, str, str]], list[tuple[str, int, str, str]]]:
    """Return (hits, allowlisted) as (term, lineno, line, allowlist_reason)."""
    hits: list[tuple[str, int, str, str]] = []
    allowlisted: list[tuple[str, int, str, str]] = []
    with open(path, encoding="utf-8", errors="replace") as fh:
        for lineno, line in enumerate(fh, start=1):
            for term_id, pattern in patterns:
                if not pattern.search(line):
                    continue
                reason = allowlist_reason(path, term_id, allowlist)
                if reason:
                    allowlisted.append((term_id, lineno, line.rstrip(), reason))
                else:
                    hits.append((term_id, lineno, line.rstrip(), ""))
    return hits, allowlisted


def allowlist_reason(
    path: Path, term_id: str, allowlist: list[dict]
) -> str | None:
    try:
        rel = path.relative_to(REPO_ROOT).as_posix()
    except ValueError:
        rel = None
    for row in allowlist:
        if row["term"] != term_id:
            continue
        if (rel and re.fullmatch(row["path"], rel)) or re.fullmatch(
            row["path"], path.name
        ):
            return row["reason"]
    return None


def collect_files(scope: list[str]) -> list[Path]:
    files: list[Path] = []
    for entry in scope:
        base = REPO_ROOT / entry
        if base.is_file():
            files.append(base)
        elif base.is_dir():
            files.extend(p for p in sorted(base.rglob("*")) if p.is_file())
    return files


def main() -> int:
    parser = argparse.ArgumentParser(description="OmidenOS brand scan")
    parser.add_argument("--mode", choices=["strict"], default="strict")
    parser.add_argument(
        "--path",
        action="append",
        default=[],
        help="restrict scan to these paths (repeatable)",
    )
    args = parser.parse_args()

    terms_cfg = load_toml(REPO_ROOT / FORBIDDEN_TERMS_FILE)
    allow_cfg = load_toml(REPO_ROOT / ALLOWLIST_FILE)
    patterns = compile_patterns(terms_cfg["forbidden"])
    allowlist = allow_cfg.get("allowlist", [])

    scope = args.path or list(DEFAULT_STRICT_SCOPE)
    all_hits: list[tuple[Path, str, int, str]] = []
    allow_count = 0
    for path in collect_files(scope):
        if not is_text_file(path):
            continue
        file_hits, file_allowlisted = scan_file(path, patterns, allowlist)
        for term_id, lineno, line, _ in file_hits:
            all_hits.append((path, term_id, lineno, line))
        allow_count += len(file_allowlisted)

    if all_hits:
        print(f"brand-scan ({args.mode}): FAILED, {len(all_hits)} hit(s)")
        for path, term_id, lineno, line in all_hits:
            try:
                rel = path.relative_to(REPO_ROOT)
            except ValueError:
                rel = path
            print(f"  {rel}:{lineno}: [{term_id}] {line.strip()}")
        return 1
    print(
        f"brand-scan ({args.mode}): OK "
        f"({allow_count} allowlisted occurrence(s) documented)"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
