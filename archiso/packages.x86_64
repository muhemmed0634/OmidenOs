#
# Packages for the OmidenOS live medium (x86_64), Phase 2 interim set.
# Selection rationale:
# - `linux` is the stock kernel for the Phase 2 boot proof only;
#   linux-omiden replaces it in Phase 3 (ADR-0002).
# - `mkinitcpio-archiso` provides the stock live hooks for the interim
#   boot; omidenos-initcpio replaces it in Phase 3 (ADR-0003).
# - NetworkManager is the permanent network backend (section 3).
# - Rescue/installation helpers follow the installer needs (ext4-only,
#   systemd-boot: dosfstools for the ESP, e2fsprogs for root).

base
linux
linux-firmware
mkinitcpio
mkinitcpio-archiso
sudo
zsh
grml-zsh-config
efibootmgr
dosfstools
e2fsprogs
parted
networkmanager
nano
tmux
# Live-session polish, no applications: the login card, a readable console
# font, and the two shell plugins that make the prompt feel current.
fastfetch
terminus-font
zsh-syntax-highlighting
zsh-autosuggestions

# Graphical stack: one display manager, three sessions in v1.0 (XFCE, i3,
# Hyprland). KDE Plasma is a v1.1 sub-phase. Shared plumbing first, then
# the sessions, then the session helpers. Hyprland needs mesa and the
# portal; X11 sessions need the X server and the input driver.
xorg-server
xf86-input-libinput
xorg-xwayland
mesa
polkit
xdg-utils
xdg-desktop-portal
xdg-desktop-portal-gtk
xdg-desktop-portal-hyprland
sddm
noto-fonts
ttf-dejavu
xfce4
xfce4-terminal
thunar
mousepad
i3-wm
i3status
i3lock
rofi
hyprland
waybar
wofi
kitty
swaybg
feh
pipewire
pipewire-pulse
wireplumber
network-manager-applet
xfce4-power-manager
xfce4-pulseaudio-plugin
xfce4-screenshooter
