#
# Packages for the OmidenOS live medium (x86_64).
# Selection rationale:
# - `linux` is the stock kernel for the interim boot path only;
#   linux-omiden replaces it in Phase 3 (ADR-0002).
# - `mkinitcpio-archiso` provides the stock live hooks for the interim
#   boot; omidenos-initcpio replaces it in Phase 3 (ADR-0003).
# - NetworkManager is the permanent network backend (section 3).
# - Rescue/installation helpers follow the installer needs (ext4-only,
#   systemd-boot: dosfstools for the ESP, e2fsprogs for root).

base
linux
linux-firmware
mkinitcpio
mkinitcpio-archiso
sudo
zsh
grml-zsh-config
efibootmgr
dosfstools
e2fsprogs
parted
networkmanager
dbus
nano
tmux
# Live-session polish, no applications: the login card, a readable console
# font, and the two shell plugins that make the prompt feel current.
fastfetch
terminus-font
zsh-syntax-highlighting
zsh-autosuggestions

# Graphical stack: one X11 session in v1.0. XFCE is the only desktop
# (ADR-0010), SDDM the only display manager (ADR-0006), and Plymouth
# draws the boot splash from the project artwork (ADR-0011).
# xorg-xwayland is not needed: no session in this profile is a Wayland
# compositor, and the X server is what XFCE, SDDM and Calamares use.
xorg-server
xf86-input-libinput
mesa
polkit
xdg-utils
xdg-desktop-portal
xdg-desktop-portal-gtk
sddm
plymouth
# XFCE, one package at a time: the group is the same set, but listing the
# members keeps the file readable and makes a dropped session package a
# visible deletion rather than a silent change inside a group.
exo
garcon
xfconf
xfdesktop
xfwm4
xfce4-session
xfce4-settings
xfce4-panel
xfce4-power-manager
xfce4-appfinder
xfce4-terminal
xfce4-whiskermenu-plugin
xfce4-pulseaudio-plugin
xfce4-screenshooter
xfce4-taskmanager
thunar
thunar-volman
tumbler
gvfs
mousepad
ristretto
adwaita-icon-theme
noto-fonts
ttf-dejavu
network-manager-applet
pipewire
pipewire-pulse
wireplumber
