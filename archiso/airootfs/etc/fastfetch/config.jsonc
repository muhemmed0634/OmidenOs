//
// Login card for the live session. No logo: a text console cannot draw the
// crest, and a neutral list of facts reads better than a borrowed ASCII mark.
// Kept to nine short lines so it costs one screen and no scrolling.

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "title",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "memory",
    "disk",
    "localip"
  ]
}
