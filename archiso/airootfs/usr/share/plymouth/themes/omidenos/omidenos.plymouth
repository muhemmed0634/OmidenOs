#
# Plymouth theme of the live medium (ADR-0011). The script plugin draws
# the artwork and the progress dots, so the splash needs no font package
# inside the initramfs.

[Plymouth Theme]
Name=OmidenOS
Description=OmidenOS boot splash
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/omidenos
ScriptFile=/usr/share/plymouth/themes/omidenos/omidenos.script
