#!/bin/sh
# SPDX-FileCopyrightText: OmidenOS project
# SPDX-License-Identifier: BSD-3-Clause
#
# Applies the live-medium wallpaper to the XFCE session. XFCE stores one
# backdrop per monitor and workspace in the xfce4-desktop channel, and the
# monitor names only exist after xfdesktop has probed the display, so every
# last-image property that already exists is filled in, plus the
# single-monitor default path, which is created when it is missing.
#
# Called from ~/.config/autostart/omidenos-session.desktop on login.

set -u

wallpaper=/usr/share/backgrounds/omidenos/wallpaper.png

[ -r "$wallpaper" ] || exit 0
command -v xfconf-query >/dev/null 2>&1 || exit 0

apply() {
	xfconf-query -c xfce4-desktop -p "$1/last-image" \
		-n -t string -s "$wallpaper" >/dev/null 2>&1 || true
	xfconf-query -c xfce4-desktop -p "$1/image-path" \
		-n -t string -s "$wallpaper" >/dev/null 2>&1 || true
	xfconf-query -c xfce4-desktop -p "$1/image-style" \
		-n -t int -s 5 >/dev/null 2>&1 || true
}

xfconf-query -c xfce4-desktop -l 2>/dev/null |
	sed -n 's|^\(.*\)/last-image$|\1|p' |
	while read -r backdrop; do
		apply "$backdrop"
	done

apply /backdrop/screen0/monitor0/workspace0

exit 0
