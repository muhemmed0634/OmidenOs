#!/bin/sh
# SPDX-FileCopyrightText: OmidenOS project
# SPDX-License-Identifier: BSD-3-Clause
#
# Prints the numbers that decide whether the live medium actually boots
# light. Run it inside the running live session and paste the output into
# docs/dev/building.md when a measurement is recorded.

set -u

echo "== kernel =="
uname -r

echo
echo "== total boot (firmware + loader + userspace) =="
systemd-analyze

echo
echo "== slowest units =="
systemd-analyze blame | head -n 10

echo
echo "== critical chain =="
systemd-analyze critical-chain | head -n 15

echo
echo "== memory (MiB) =="
free -m

echo
echo "== live root =="
findmnt -no SOURCE,FSTYPE,OPTIONS /

echo
echo "== image footprint =="
df -h / | tail -n 1

echo
echo "== enabled units =="
systemctl list-unit-files --state=enabled --no-pager | tail -n +2 | wc -l
