/* OmidenOs - Rofi Configuration */

configuration {
    modi:                       "drun,run,window";
    show-icons:                 true;
    display-drun:               "  Apps";
    display-run:                "  Run";
    display-window:             "  Windows";
    drun-display-format:        "{name}";
    font:                       "Noto Sans 12";
}

@theme "omiden"
