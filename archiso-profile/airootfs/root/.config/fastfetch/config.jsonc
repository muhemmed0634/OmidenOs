{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "small",
        "source": "~/.config/fastfetch/omiden.txt",
        "color": {
            "1": "magenta",
            "2": "cyan"
        },
        "padding": {
            "top": 1,
            "left": 1
        }
    },

    "display": {
        "separator": "  →  ",
        "color": {
            "keys": "magenta",
            "title": "cyan"
        }
    },

    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}",
            "color": {
                "user": "magenta",
                "at": "white",
                "host": "cyan"
            }
        },
        "separator",
        {
            "type": "os",
            "key": "OS",
            "keyColor": "magenta"
        },
        {
            "type": "kernel",
            "key": "Kernel",
            "keyColor": "magenta"
        },
        {
            "type": "uptime",
            "key": "Uptime",
            "keyColor": "magenta"
        },
        {
            "type": "packages",
            "key": "Packages",
            "keyColor": "magenta"
        },
        {
            "type": "shell",
            "key": "Shell",
            "keyColor": "cyan"
        },
        {
            "type": "display",
            "key": "Resolution",
            "keyColor": "cyan"
        },
        {
            "type": "wm",
            "key": "WM",
            "keyColor": "cyan"
        },
        {
            "type": "theme",
            "key": "Theme",
            "keyColor": "cyan"
        },
        {
            "type": "icons",
            "key": "Icons",
            "keyColor": "cyan"
        },
        {
            "type": "terminal",
            "key": "Terminal",
            "keyColor": "cyan"
        },
        {
            "type": "cpu",
            "key": "CPU",
            "keyColor": "yellow"
        },
        {
            "type": "gpu",
            "key": "GPU",
            "keyColor": "yellow",
            "driverSpecific": true
        },
        {
            "type": "memory",
            "key": "Memory",
            "keyColor": "yellow"
        },
        {
            "type": "disk",
            "key": "Disk",
            "keyColor": "yellow",
            "folders": "/"
        },
        {
            "type": "localip",
            "key": "Local IP",
            "keyColor": "green"
        },
        {
            "type": "publicip",
            "key": "Public IP",
            "keyColor": "green",
            "timeout": 3000
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 1,
            "symbol": "circle"
        }
    ]
}
