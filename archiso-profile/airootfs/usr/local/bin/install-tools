    "stegsnow:StegSnow — Whitespace steganography"
)

OSINT=(
    "sn0int:Sn0int — OSINT framework"
    "inquisitor:Inquisitor — Info gathering"
)

CRYPTO=(
    "sbd:SBD — Secure backdoor"
    "tbear:TBEAR — Token-based encryption"
)

SCANNER=(
    "sslcaudit:SSLAudit — SSL/TLS audit"
    "sslsplit:SSLSplit — SSL intercept"
    "tlsfuzzer:TLSFuzzer — TLS fuzzer"
    "uniscan:UniScan — Web vulnerability scanner"
    "urlbuster:URLBuster — URL fuzzer"
    "urldigger:URLDigger — URL extractor"
    "t50:T50 — Packet injector"
    "tinfoleak:TInfoLeak — Info leak scanner"
    "zmap:ZMap — High-speed scanner"
    "zbar:ZBar — Barcode reader"
)

MISC=(
    "maltrail:MalTrail — Malicious traffic detection"
    "pyexfil:PyExfil — Data exfiltration toolkit"
    "wce:WCE — Windows credential editor"
    "peach:Peach — Fuzzing framework"
    "pentestly:Pentestly — Pentest framework"
    "iodine:Iodine — DNS tunnel"
    "powersploit:PowerSploit — PowerShell post-exploit"
    "pwnat:PWNAT — NAT traversal"
    "irpas:IRPAS — Routing protocol attack"
)

ALL_CATEGORIES=("HEAVY_GUI" "WEB" "EXPLOIT" "MOBILE" "REVERSE" "FORENSICS" "NETWORK" "PASSWORD" "STEGO" "OSINT" "CRYPTO" "SCANNER" "MISC")
ALL_LABELS=("Heavy GUI" "Web Testing" "Exploitation" "Mobile/Android" "Reverse Eng" "Forensics" "Network/AD" "Password" "Steganography" "OSINT" "Crypto" "Scanners" "Misc")

count_total() {
    local total=0
    for cat in "${ALL_CATEGORIES[@]}"; do
        eval "total+=\${#${cat}[@]}"
    done
    echo "$total"
}

TOTAL=$(count_total)

show_menu() {
    banner
    echo -e "  ${W}Available tools ($TOTAL total):${N}"
    echo ""

    local idx=1
    for i in "${!ALL_CATEGORIES[@]}"; do
        local cat="${ALL_CATEGORIES[$i]}"
        local label="${ALL_LABELS[$i]}"
        echo -e "  ${M}${BOLD}── $label ──${N}"
        eval "local arr=(\"\${${cat}[@]}\")"
        for t in "${arr[@]}"; do
            local name="${t%%:*}"
            local desc="${t##*:}"
            printf "    ${C}[%3d]${N} %-28s %s\n" "$idx" "$name" "$desc"
            ((idx++))
        done
        echo ""
    done

    echo -e "  ${G}[  a]${N} Install ALL ($TOTAL tools)"
    echo -e "  ${Y}[  c]${N} Install by category"
    echo -e "  ${R}[  q]${N} Quit"
    echo ""
}

show_category_menu() {
    banner
    echo -e "  ${W}Select category:${N}\n"
    for i in "${!ALL_CATEGORIES[@]}"; do
        local cat="${ALL_CATEGORIES[$i]}"
        local label="${ALL_LABELS[$i]}"
        eval "local count=\${#${cat}[@]}"
        printf "  ${C}[%2d]${N} %-24s (%d tools)\n" "$((i+1))" "$label" "$count"
    done
    echo -e "  ${R}[ 0]${N} Back\n"
}

install_pkg() {
    local pkg="$1"
    info "Installing $pkg..."
    if pacman -S --noconfirm --needed "$pkg" 2>/dev/null; then
        info "$pkg installed."
    else
        warn "$pkg failed — run setup-blackarch first."
    fi
}

install_category() {
    local cat_name="$1"
    local label="$2"
    step "Installing $label"
    eval "local arr=(\"\${${cat_name}[@]}\")"
    for t in "${arr[@]}"; do
        install_pkg "${t%%:*}"
    done
}

install_all() {
    step "Installing all $TOTAL tools"
    for i in "${!ALL_CATEGORIES[@]}"; do
        install_category "${ALL_CATEGORIES[$i]}" "${ALL_LABELS[$i]}"
    done
}

main() {
    show_menu
    read -p "  Select [1-$TOTAL/a/c/q]: " choice

    if [[ "$choice" == "q" ]]; then
        exit 0
    elif [[ "$choice" == "a" ]]; then
        install_all
    elif [[ "$choice" == "c" ]]; then
        show_category_menu
        read -p "  Category [1-${#ALL_CATEGORIES[@]}/0]: " cat_choice
        if [[ "$cat_choice" =~ ^[1-9]$ ]] && (( cat_choice <= ${#ALL_CATEGORIES[@]} )); then
            local idx=$((cat_choice - 1))
            install_category "${ALL_CATEGORIES[$idx]}" "${ALL_LABELS[$idx]}"
        fi
    elif [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= TOTAL )); then
        local idx=1
        for i in "${!ALL_CATEGORIES[@]}"; do
            local cat="${ALL_CATEGORIES[$i]}"
            eval "local arr=(\"\${${cat}[@]}\")"
            for t in "${arr[@]}"; do
                if (( idx == choice )); then
                    step "Installing ${t%%:*}"
                    install_pkg "${t%%:*}"
                    break 2
                fi
                ((idx++))
            done
        done
    else
        warn "Invalid selection."
    fi

    echo ""
    info "Done. Run again to install more tools."
}

main "$@"
