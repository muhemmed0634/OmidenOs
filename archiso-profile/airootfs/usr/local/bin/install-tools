#!/bin/bash
# ============================================================
# OmidenOS - Security Tools Installer (100+ tools)
# Installs additional tools not included in the base ISO
# GitHub: https://github.com/muhemmed0634/OmidenOS
# ============================================================

set -e

R='\033[0;31m' G='\033[0;32m' Y='\033[1;33m'
C='\033[0;36m' W='\033[1;37m' M='\033[0;35m' N='\033[0m' BOLD='\033[1m'

info()  { echo -e "  ${G}[✔]${N} $*"; }
warn()  { echo -e "  ${Y}[!]${N} $*"; }
err()   { echo -e "  ${R}[✘]${N} $*"; }
step()  { echo -e "\n${C}${BOLD}━━━ $* ━━━${N}\n"; }

banner() {
    clear
    echo -e "${M}${BOLD}"
    cat << 'BANNER'
  ╔══════════════════════════════════════════╗
  ║  OmidenOS — Security Tools Installer    ║
  ║  100+ tools | github.com/muhemmed0634   ║
  ╚══════════════════════════════════════════╝
BANNER
    echo -e "${N}"
}

# ─── Tool Categories ─────────────────────────────────────────
# Format: "package:description"

HEAVY_GUI=(
    "burpsuite:Burp Suite — Web proxy scanner (688 MB)"
    "ghidra:Ghidra — NSA reverse engineering (355 MB)"
    "autopsy:Autopsy — Digital forensics (1 GB)"
    "maltego:Maltego — OSINT & link analysis (180 MB)"
    "neo4j-community:Neo4j — BloodHound graph DB (126 MB)"
    "retdec:RetDec — Decompiler (124 MB)"
    "havoc-c2:Havoc C2 — Post-exploitation (158 MB)"
)

WEB=(
    "w3af:W3AF — Web app attack & audit"
    "arachni:Arachni — Web vulnerability scanner"
    "set:SET — Social Engineering Toolkit"
    "a2sv:A2SV — Auto Scanner for SQLi/XSS"
    "abuse-ssl-bypass-waf:Abuse-SSL — WAF bypass"
    "anti-xss:Anti-XSS — XSS detection"
    "apache-users:Apache-Users — Enumerate users"
    "laudanum:Laudanum — Injection helpers"
    "swaks:SWAKS — SMTP test tool"
    "webanalyze:WebAnalyze — Web tech fingerprint"
    "webtech:WebTech — Web technology detection"
    "xsser:XSSer — XSS scanner"
    "xsspire:XSSpire — XSS framework"
)

EXPLOIT=(
    "armitage:Armitage — Metasploit GUI"
    "ace:ACE — Android Custom Exploit"
    "hyperfox:HyperFox — MITM proxy"
    "iaito:Iaito — Radare2 GUI"
    "irpas:IRPAS — Routing protocol tools"
    "powerstager:PowerStager — PowerShell stager"
    "powersploit:PowerSploit — PowerShell toolkit"
    "pwnat:PWNAT — NAT piercing"
    "sparta:Sparta — Network infrastructure scanner"
    "unicornscan:Unicornscan — Port scanner"
)

MOBILE=(
    "jadx:JADX — Java/APK decompiler"
    "androguard:Androguard — Android analysis"
    "dex2jar:dex2jar — DEX to Java converter"
    "mobsf:MobSF — Mobile Security Framework"
    "android-apktool:Apktool — APK decompiler"
    "android-backup-extractor:ABE — Android backup extractor"
    "androick:Androick — Android forensic tool"
    "androbugs:AndroBugs — Android vulnerability scanner"
    "androwarn:AndroWarn — Android static analysis"
)

REVERSE=(
    "rizin:Rizin — Reverse engineering framework"
    "capstone:Capstone — Disassembly engine"
    "unicorn:Unicorn — CPU emulator"
    "keystone:Keystone — Assembler engine"
    "z3:Z3 — SMT solver from Microsoft"
    "ropgadget:ROPgadget — ROP finder"
    "ropper:Ropper — ROP chain tool"
    "gef:GEF — GDB enhanced features"
    "angr-management:Angr — Binary analysis GUI"
    "amoco:Amoco — Binary analysis"
)

FORENSICS=(
    "rifiuti2:rifiuti2 — Recycle bin forensics"
    "ophcrack:Ophcrack — Windows password cracker"
    "stegcracker:Stegcracker — Steganography brute force"
    "pngcheck:pngcheck — PNG file verifier"
    "scalpel:Scalpel — File carving tool"
    "volafox:volafox — Memory forensics"
    "libewf:libewf — Expert Witness format library"
    "aesfix:AESFix — AES key recovery"
    "aeskeyfind:AESKeyFind — AES key finder"
    "afflib:AFFLib — Advanced Forensic Format"
    "aimage:AImage — Disk imaging"
    "analyzemft:AnalyzeMFT — MFT analysis"
    "dumpzilla:Dumpzilla — Firefox forensics"
    "vinetto:Vinetto — Thumbs.db analysis"
    "vbindiff:VBinDiff — Visual binary diff"
)

