    "netexec:NetExec — Network execution (CME fork)"
    "rita:RITA — Traffic intelligence analysis"
    "smbclient:SMBClient — SMB/CIFS client"
    "samba:Samba — SMB file sharing"
    "acccheck:AccCheck — SMB password checker"
    "activedirectoryenum:ADEnum — Active Directory enum"
    "ad-ldap-enum:AD-LDAP-Enum — LDAP enumeration"
    "adfind:AdFind — Active Directory query"
    "adfspray:ADSpray — AD password spray"
    "adidnsdump:Adidnsdump — AD DNS dump"
    "allthevhosts:AllTheVHosts — Virtual host discovery"
    "alterx:AlterX — Subdomain generator"
