#!/usr/bin/env bash
# OmidenOs Minimal Installer v4.0 - Stability First
set -euo pipefail

R="\033[0;31m" G="\033[0;32m" Y="\033[1;33m" 
C="\033[0;36m" W="\033[1;37m" N="\033[0m" B="\033[1m"

DISK=""
ROOT_PART=""
EFI_PART=""
BOOT_MODE=""
HOSTNAME="omidenos"
USERNAME="user"
USER_PASS=""
ROOT_PASS=""
TIMEZONE="UTC"

info() { echo -e "  ${G}[✔]${N} $*"; }
warn() { echo -e "  ${Y}[!]${N} $*"; }
err()  { echo -e "  ${R}[✘]${N} $*"; }
die()  { err "$*"; exit 1; }
ask()  { echo -en "  ${W}[?]${N} $*: "; }

banner() {
    clear
    echo -e "${C}${B}"
    echo "  ╔═══════════════════════════════════════╗"
    echo "  ║     OmidenOs Minimal Installer v4.0   ║"
    echo "  ║     Stability First - No Desktop      ║"
    echo "  ╚═══════════════════════════════════════╝"
    echo -e "${N}"
}

check_root() {
    [[ $EUID -eq 0 ]] || die "Run as root: sudo install-omiden"
}

check_uefi() {
    if [[ -d /sys/firmware/efi ]]; then
        BOOT_MODE="UEFI"
    else
        BOOT_MODE="BIOS"
    fi
    info "Boot: $BOOT_MODE"
}

check_net() {
    info "Testing network..."
    if ping -c1 -W3 archlinux.org &>/dev/null; then
        info "Network: OK"
    else
        die "No internet! Run: nmtui"
    fi
}

select_disk() {
    echo -e "\n${C}Available disks:${N}"
    lsblk -d -o NAME,SIZE,TYPE | grep disk
    echo ""
    while true; do
        ask "Disk (e.g. sda, nvme0n1)"
        read -r d
        DISK="/dev/$d"
        [[ -b "$DISK" ]] && break
        err "Not found: $DISK"
    done
    
    echo -e "\n${R}${B}⚠ ALL DATA ON $DISK WILL BE ERASED! ⚠${N}"
    ask "Type YES to confirm"
    read -r c
    [[ "$c" == "YES" ]] || die "Aborted"
}

gather_config() {
    echo ""
    ask "Hostname [omidenos]"; read -r h; HOSTNAME="${h:-omidenos}"
    ask "Username [user]"; read -r u; USERNAME="${u:-user}"
    
    while true; do
        ask "Password for $USERNAME"; read -rs USER_PASS; echo ""
        ask "Confirm"; read -rs c; echo ""
        [[ -n "$USER_PASS" && "$USER_PASS" == "$c" ]] && break
        err "Password mismatch or empty"
    done
    
    ask "Root password (blank=disabled)"; read -rs ROOT_PASS; echo ""
    
    echo -e "\n${C}Timezone:${N}"
    echo "  1) UTC  2) Asia/Baku  3) Europe/Istanbul  4) Other"
    ask "Choice [1]"; read -r tz
    case "${tz:-1}" in
        2) TIMEZONE="Asia/Baku" ;;
        3) TIMEZONE="Europe/Istanbul" ;;
        4) ask "Enter timezone"; read -r TIMEZONE ;;
        *) TIMEZONE="UTC" ;;
    esac
}

partition_disk() {
    info "Partitioning $DISK..."
    wipefs -af "$DISK" &>/dev/null || true
    
    if [[ "$BOOT_MODE" == "UEFI" ]]; then
        parted -s "$DISK" mklabel gpt
        parted -s "$DISK" mkpart "EFI" fat32 1MiB 513MiB
        parted -s "$DISK" set 1 esp on
        parted -s "$DISK" mkpart "Root" ext4 513MiB 100%
        
        [[ "$DISK" =~ nvme|mmcblk ]] && EFI_PART="${DISK}p1" || EFI_PART="${DISK}1"
        [[ "$DISK" =~ nvme|mmcblk ]] && ROOT_PART="${DISK}p2" || ROOT_PART="${DISK}2"
        
        sleep 2
        mkfs.fat -F32 "$EFI_PART" || die "mkfs.fat failed"
    else
        parted -s "$DISK" mklabel msdos
        parted -s "$DISK" mkpart primary ext4 1MiB 100%
        parted -s "$DISK" set 1 boot on
        
        [[ "$DISK" =~ nvme|mmcblk ]] && ROOT_PART="${DISK}p1" || ROOT_PART="${DISK}1"
    fi
    
    sleep 2
    mkfs.ext4 -F "$ROOT_PART" || die "mkfs.ext4 failed"
    mount "$ROOT_PART" /mnt || die "mount failed"
    
    if [[ "$BOOT_MODE" == "UEFI" ]]; then
        mkdir -p /mnt/boot/efi
        mount "$EFI_PART" /mnt/boot/efi || die "EFI mount failed"
    fi
    
    info "Partitions ready"
}

install_base() {
    info "Installing base system..."
    pacman -Sy --noconfirm archlinux-keyring &>/dev/null || true
    
    if ! pacstrap -K /mnt base linux linux-firmware networkmanager grub \
                      efibootmgr sudo nano git curl wget zsh bash htop; then
        die "pacstrap failed! Check network."
    fi
    
    genfstab -U /mnt >> /mnt/etc/fstab
    info "Base installed"
}

configure_system() {
    info "Configuring system..."
    
    cat > /mnt/tmp/setup.sh << SETUPEOF
#!/bin/bash
ln -sf /usr/share/zoneinfo/${TIMEZONE} /etc/localtime
hwclock --systohc 2>/dev/null || true

echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen
locale-gen
echo "LANG=en_US.UTF-8" > /etc/locale.conf

echo "${HOSTNAME}" > /etc/hostname
cat > /etc/hosts << HOSTSEOF
127.0.0.1   localhost
::1         localhost
127.0.1.1   ${HOSTNAME}
HOSTSEOF

useradd -m -G wheel -s /bin/zsh ${USERNAME}
echo "${USERNAME}:${USER_PASS}" | chpasswd
[[ -n "${ROOT_PASS}" ]] && echo "root:${ROOT_PASS}" | chpasswd || passwd -l root

sed -i "s/^# %wheel ALL=(ALL:ALL) ALL/%wheel ALL=(ALL:ALL) ALL/" /etc/sudoers

systemctl enable NetworkManager

if [[ "${BOOT_MODE}" == "UEFI" ]]; then
    grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=OmidenOs
else
    grub-install --target=i386-pc ${DISK}
fi

grub-mkconfig -o /boot/grub/grub.cfg
mkinitcpio -P
SETUPEOF
    
    chmod +x /mnt/tmp/setup.sh
    arch-chroot /mnt /tmp/setup.sh || die "Config failed"
    rm /mnt/tmp/setup.sh
    
    info "System configured"
}

finish() {
    echo -e "\n${G}${B}✓ Installation Complete!${N}\n"
    echo -e "  Hostname: $HOSTNAME"
    echo -e "  User:     $USERNAME"
    echo -e "  Boot:     $BOOT_MODE\n"
    
    ask "Reboot now? [Y/n]"
    read -r r
    if [[ "${r:-y}" =~ ^[Yy]$ ]]; then
        umount -R /mnt 2>/dev/null || true
        reboot
    fi
}

main() {
    banner
    check_root
    check_uefi
    check_net
    select_disk
    gather_config
    partition_disk
    install_base
    configure_system
    finish
}

main
