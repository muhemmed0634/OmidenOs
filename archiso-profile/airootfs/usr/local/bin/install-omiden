#!/usr/bin/env bash
# ============================================================
# OmidenOs Installer — Custom Bash Installer
# GitHub: https://github.com/muhemmed0634/OmidenOs
# NO archinstall dependency — fully self-contained
# ============================================================

set -euo pipefail

# ─── Colors ──────────────────────────────────────────────────
R='\033[0;31m' G='\033[0;32m' Y='\033[1;33m'
B='\033[0;34m' M='\033[0;35m' C='\033[0;36m'
W='\033[1;37m' N='\033[0m'    BOLD='\033[1m'

# ─── State ───────────────────────────────────────────────────
DISK=""
ROOT_PART=""
EFI_PART=""
BOOT_MODE=""
HOSTNAME="omidenos"
USERNAME="user"
USER_PASS=""
ROOT_PASS=""
TIMEZONE="UTC"
INSTALL_BLACKARCH=false
INSTALL_DESKTOP=true
FS_TYPE="ext4"

# ─── Helpers ─────────────────────────────────────────────────
info()    { echo -e "  ${G}[✔]${N} $*"; }
warn()    { echo -e "  ${Y}[!]${N} $*"; }
err()     { echo -e "  ${R}[✘]${N} $*"; }
step()    { echo -e "\n${C}${BOLD}━━━ $* ━━━${N}\n"; }
ask()     { echo -en "  ${W}[?]${N} $*: "; }
confirm() { echo -en "  ${Y}[?]${N} $* [y/N]: "; read -r __ans; [[ "$__ans" =~ ^[Yy]$ ]]; }
die()     { err "$*"; exit 1; }

banner() {
    clear
    echo -e "${M}${BOLD}"
    cat << 'BANNER'
  ╔══════════════════════════════════════════════════╗
  ║                                                  ║
  ║   ██████╗ ███╗   ███╗██╗██████╗ ███████╗███╗  ██╗ ║
  ║  ██╔═══██╗████╗ ████║██║██╔══██╗██╔════╝████╗  ██║ ║
  ║  ██║   ██║██╔████╔██║██║██║  ██║█████╗  ██╔██╗ ██║ ║
  ║  ██║   ██║██║╚██╔╝██║██║██║  ██║██╔══╝  ██║╚██╗██║ ║
  ║  ╚██████╔╝██║ ╚═╝ ██║██║██████╔╝███████╗██║ ╚████║ ║
  ║   ╚═════╝ ╚═╝     ╚═╝╚═╝╚═════╝ ╚══════╝╚═╝  ╚═══╝ ║
  ║                                                  ║
  ║          Custom Installer  v2.1                   ║
  ║    github.com/muhemmed0634/OmidenOs               ║
  ╚══════════════════════════════════════════════════╝
BANNER
    echo -e "${N}"
}

# ─── Pre-flight checks ───────────────────────────────────────
check_root() {
    [[ $EUID -eq 0 ]] || die "Must be run as root. Try: sudo install-omiden"
}

check_uefi() {
    if [[ -d /sys/firmware/efi/efivars ]]; then
        BOOT_MODE="UEFI"
    else
        BOOT_MODE="BIOS"
    fi
    info "Boot mode: ${BOLD}$BOOT_MODE"
}

check_internet() {
    step "Internet Connection"
    if ping -c1 -W3 archlinux.org &>/dev/null; then
        info "Internet: Connected"
    else
        warn "No internet detected."
        confirm "Continue without internet?" || die "Aborted."
    fi
}

update_mirrors() {
    step "Updating Mirrors"
    if command -v reflector &>/dev/null; then
        info "Running reflector..."
        reflector --age 12 --protocol https --sort rate \
                  --save /etc/pacman.d/mirrorlist 2>/dev/null \
            && info "Mirrors updated." \
            || warn "reflector failed, using existing mirrors."
    else
        warn "reflector not found, skipping."
    fi
    pacman -Syy --noconfirm &>/dev/null || true
    info "Package databases synced."
}

# ─── Disk Selection ──────────────────────────────────────────
select_disk() {
    step "Disk Selection"
    echo -e "  ${C}Available block devices:${N}\n"
    lsblk -d -o NAME,SIZE,MODEL,TYPE | grep -v "^loop\|^rom\|^airoot" || true
    echo ""

    while true; do
        ask "Target disk (e.g. sda, nvme0n1)"
        read -r raw_disk
        DISK="/dev/${raw_disk}"
        [[ -b "$DISK" ]] && break
        err "Device $DISK not found. Try again."
    done

    echo ""
    echo -e "  ${R}${BOLD}⚠  ALL DATA ON ${DISK} WILL BE PERMANENTLY ERASED  ⚠${N}"
    echo -e "  ${Y}Size: $(lsblk -dn -o SIZE "$DISK")${N}"
    echo ""
    ask "Type 'ERASE' to confirm"
    read -r __confirm
    [[ "$__confirm" == "ERASE" ]] || die "Disk erasure not confirmed. Aborted."
}

# ─── Filesystem Choice ───────────────────────────────────────
select_filesystem() {
    step "Filesystem"
    echo "  1) ext4   — Stable, widely supported (recommended)"
    echo "  2) btrfs  — Snapshots, compression, subvolumes"
    echo "  3) xfs    — High performance"
    echo ""
    ask "Choose filesystem [1-3] (default: 1)"
    read -r __fs
    case "${__fs:-1}" in
        2) FS_TYPE="btrfs" ;;
        3) FS_TYPE="xfs" ;;
        *) FS_TYPE="ext4" ;;
    esac
    info "Filesystem: $FS_TYPE"
}

# ─── System Configuration ────────────────────────────────────
gather_config() {
    step "System Configuration"

    # Timezone — numbered list
    echo -e "  ${W}Select timezone:${N}"
    echo -e "  ${C} 1)${N} Asia/Baku"
    echo -e "  ${C} 2)${N} Europe/Istanbul"
    echo -e "  ${C} 3)${N} Europe/London"
    echo -e "  ${C} 4)${N} Europe/Moscow"
    echo -e "  ${C} 5)${N} America/New_York"
    echo -e "  ${C} 6)${N} America/Los_Angeles"
    echo -e "  ${C} 7)${N} Asia/Dubai"
    echo -e "  ${C} 8)${N} Europe/Berlin"
    echo -e "  ${C} 9)${N} Asia/Tokyo"
    echo -e "  ${C}10)${N} UTC"
    echo -e "  ${C} 0)${N} Other (type manually)"
    echo ""
    ask "Choose [1-10/0]"
    read -r __tz_choice
    case "${__tz_choice:-1}" in
        1) TIMEZONE="Asia/Baku" ;;
        2) TIMEZONE="Europe/Istanbul" ;;
        3) TIMEZONE="Europe/London" ;;
        4) TIMEZONE="Europe/Moscow" ;;
        5) TIMEZONE="America/New_York" ;;
        6) TIMEZONE="America/Los_Angeles" ;;
        7) TIMEZONE="Asia/Dubai" ;;
        8) TIMEZONE="Europe/Berlin" ;;
        9) TIMEZONE="Asia/Tokyo" ;;
        10) TIMEZONE="UTC" ;;
        0) ask "Type timezone (e.g. Asia/Baku)"
           read -r __tz
           if [[ -f "/usr/share/zoneinfo/${__tz:-UTC}" ]]; then
               TIMEZONE="$__tz"
           else
               warn "Timezone not found, using UTC."
               TIMEZONE="UTC"
           fi ;;
        *) TIMEZONE="Asia/Baku" ;;
    esac
    info "Timezone: $TIMEZONE"

    # Hostname
    ask "Hostname [omidenos]"
    read -r __host
    HOSTNAME="${__host:-omidenos}"

    # Username — only lowercase letters and digits
    while true; do
        ask "Username [user]"
        read -r __user
        USERNAME="${__user:-user}"
        [[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]*$ ]] && break
        err "Invalid username. Use lowercase letters, digits, - or _"
    done

    # Passwords
    while true; do
        echo -en "  ${W}[?]${N} Password for $USERNAME: "
        read -rs USER_PASS; echo ""
        echo -en "  ${W}[?]${N} Confirm password: "
        read -rs __confirm; echo ""
        [[ -n "$USER_PASS" && "$USER_PASS" == "$__confirm" ]] && break
        err "Passwords empty or do not match. Try again."
    done

    echo -en "  ${W}[?]${N} Root password (blank = disable root login): "
    read -rs ROOT_PASS; echo ""

    # Desktop
    if confirm "Install Openbox desktop environment?"; then
        INSTALL_DESKTOP=true
    else
        INSTALL_DESKTOP=false
    fi

    # BlackArch
    if confirm "Install BlackArch security tools?"; then
        INSTALL_BLACKARCH=true
    else
        INSTALL_BLACKARCH=false
    fi

    # Summary
    echo ""
    echo -e "  ${C}${BOLD}Summary:${N}"
    echo -e "  Disk:      $DISK ($FS_TYPE)"
    echo -e "  Boot:      $BOOT_MODE"
    echo -e "  Hostname:  $HOSTNAME"
    echo -e "  User:      $USERNAME"
    echo -e "  Timezone:  $TIMEZONE"
    echo -e "  Desktop:   $INSTALL_DESKTOP"
    echo -e "  BlackArch: $INSTALL_BLACKARCH"
    echo ""
    confirm "Proceed with installation?" || die "Aborted by user."
}

# ─── Partition & Format ──────────────────────────────────────
partition_disk() {
    step "Partitioning $DISK"

    # Wipe existing signatures
    wipefs -af "$DISK" &>/dev/null || true

    if [[ "$BOOT_MODE" == "UEFI" ]]; then
        info "Creating GPT partition table (UEFI)..."
        parted -s "$DISK" mklabel gpt
        parted -s "$DISK" mkpart "EFI" fat32 1MiB 513MiB
        parted -s "$DISK" set 1 esp on
        parted -s "$DISK" mkpart "OmidenOs" "${FS_TYPE}" 513MiB 100%

        if [[ "$DISK" =~ nvme|mmcblk ]]; then
            EFI_PART="${DISK}p1"
            ROOT_PART="${DISK}p2"
        else
            EFI_PART="${DISK}1"
            ROOT_PART="${DISK}2"
        fi

        info "Formatting EFI: $EFI_PART"
        mkfs.fat -F32 -n "EFI" "$EFI_PART"

    else
        info "Creating MBR partition table (BIOS)..."
        parted -s "$DISK" mklabel msdos
        parted -s "$DISK" mkpart primary "${FS_TYPE}" 1MiB 100%
        parted -s "$DISK" set 1 boot on

        if [[ "$DISK" =~ nvme|mmcblk ]]; then
            ROOT_PART="${DISK}p1"
        else
            ROOT_PART="${DISK}1"
        fi
    fi

    # Wait for kernel to register partitions
    sleep 2

    # Format root
    info "Formatting root: $ROOT_PART ($FS_TYPE)"
    case "$FS_TYPE" in
        btrfs) mkfs.btrfs -f -L "OmidenOs" "$ROOT_PART" ;;
        xfs)   mkfs.xfs   -f -L "OmidenOs" "$ROOT_PART" ;;
        *)     mkfs.ext4  -F -L "OmidenOs" "$ROOT_PART" ;;
    esac

    # Mount
    info "Mounting filesystems..."
    mount "$ROOT_PART" /mnt
    if [[ "$BOOT_MODE" == "UEFI" ]]; then
        mkdir -p /mnt/boot/efi
        mount "$EFI_PART" /mnt/boot/efi
    fi

    info "Partition layout:"
    lsblk "$DISK" 2>/dev/null || true
}

# ─── Base Install ─────────────────────────────────────────────
install_base() {
    step "Installing Base System"

    # Ensure network is up
    info "Checking network..."
    if ! ping -c1 -W3 archlinux.org &>/dev/null; then
        warn "No network. Trying to start NetworkManager..."
        systemctl start NetworkManager 2>/dev/null || true
        sleep 3
        if ! ping -c1 -W3 archlinux.org &>/dev/null; then
            err "No internet connection. Cannot install."
            die "Run 'nmtui' to connect to WiFi first."
        fi
    fi
    info "Network OK."

    # Sync repos
    info "Syncing package databases..."
    pacman -Syy --noconfirm &>/dev/null || true

    info "Running pacstrap (this will take a while)..."
    local PKGS=(
        base base-devel linux linux-firmware linux-headers
        networkmanager grub efibootmgr
        sudo nano vim git curl wget
        bash zsh zsh-autosuggestions zsh-syntax-highlighting
        bash-completion man-db man-pages
        xdg-utils xdg-user-dirs polkit polkit-gnome
        gvfs udisks2 upower acpid
        fastfetch btop htop inxi
        pipewire pipewire-alsa pipewire-pulse wireplumber
        bluez bluez-utils
        arch-install-scripts pacman-contrib reflector
    )

    if [[ "$INSTALL_DESKTOP" == true ]]; then
        PKGS+=(
            xorg-server xorg-xinit xorg-xrandr xf86-video-vesa mesa
            openbox tint2 rofi dunst feh picom
            lightdm lightdm-gtk-greeter
            alacritty thunar thunar-archive-plugin
            noto-fonts otf-font-awesome ttf-cascadia-code
            adw-gtk-theme papirus-icon-theme lxappearance
            pavucontrol network-manager-applet gparted
        )
    fi

    pacstrap -K /mnt "${PKGS[@]}"
    info "Base system installed."

    # Copy pacman.conf with BlackArch to installed system
    cp /etc/pacman.conf /mnt/etc/pacman.conf 2>/dev/null || true
}

# ─── Copy live configs to installed system ───────────────────
copy_configs() {
    step "Copying OmidenOs Configuration"

    local TARGET_HOME="/mnt/home/${USERNAME}"

    # Wallpaper
    mkdir -p /mnt/usr/share/wallpapers/omiden
    if [[ -f /usr/share/wallpapers/omiden/omiden-wallpaper.png ]]; then
        cp /usr/share/wallpapers/omiden/omiden-wallpaper.png \
           /mnt/usr/share/wallpapers/omiden/
        info "Wallpaper copied."
    fi

    # System icon
    mkdir -p /mnt/usr/share/pixmaps
    if [[ -f /usr/share/pixmaps/omidenos.png ]]; then
        cp /usr/share/pixmaps/omidenos.png /mnt/usr/share/pixmaps/
        info "System icon copied."
    fi

    # Skel configs (from /etc/skel if available)
    if [[ -d /etc/skel/.config ]]; then
        mkdir -p "${TARGET_HOME}/.config"
        cp -r /etc/skel/.config/* "${TARGET_HOME}/.config/" 2>/dev/null || true
        info "Desktop configs copied from skel."
    fi

    # Shell configs from skel
    for f in .bashrc .zshrc .xinitrc; do
        [[ -f "/etc/skel/$f" ]] && cp "/etc/skel/$f" "${TARGET_HOME}/$f"
    done

    # Fastfetch (from live root if skel doesn't have it)
    if [[ ! -f "${TARGET_HOME}/.config/fastfetch/omiden.txt" ]] && \
       [[ -f /root/.config/fastfetch/omiden.txt ]]; then
        mkdir -p "${TARGET_HOME}/.config/fastfetch"
        cp /root/.config/fastfetch/config.jsonc "${TARGET_HOME}/.config/fastfetch/" 2>/dev/null || true
        cp /root/.config/fastfetch/omiden.txt   "${TARGET_HOME}/.config/fastfetch/" 2>/dev/null || true
        info "Fastfetch config copied."
    fi

    # Openbox autostart
    mkdir -p "${TARGET_HOME}/.config/openbox"
    cat > "${TARGET_HOME}/.config/openbox/autostart" << 'AUTOSTART'
#!/bin/bash
feh --bg-fill /usr/share/wallpapers/omiden/omiden-wallpaper.png 2>/dev/null &
picom --daemon &
tint2 &
dunst &
nm-applet &
/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
AUTOSTART
    info "Openbox autostart created."

    # Set ownership
    arch-chroot /mnt chown -R "${USERNAME}:${USERNAME}" "/home/${USERNAME}" 2>/dev/null || true
}

# ─── Configure Chroot ────────────────────────────────────────
configure_chroot() {
    step "Configuring System"

    # fstab
    genfstab -U /mnt >> /mnt/etc/fstab
    info "fstab generated."

    # Write chroot script to /tmp and execute
    cat > /mnt/tmp/omiden-chroot.sh << CHROOT_SCRIPT
#!/bin/bash
# OmidenOs chroot configuration script

TIMEZONE="$TIMEZONE"
HOSTNAME="$HOSTNAME"
USERNAME="$USERNAME"
USER_PASS="$USER_PASS"
ROOT_PASS="$ROOT_PASS"
BOOT_MODE="$BOOT_MODE"
DISK="$DISK"
INSTALL_DESKTOP="$INSTALL_DESKTOP"
INSTALL_BLACKARCH="$INSTALL_BLACKARCH"

# Timezone
ln -sf "/usr/share/zoneinfo/\${TIMEZONE}" /etc/localtime
hwclock --systohc

# Locale
echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen
locale-gen
echo "LANG=en_US.UTF-8" > /etc/locale.conf
echo "KEYMAP=us" > /etc/vconsole.conf

# Hostname
echo "\${HOSTNAME}" > /etc/hostname
cat > /etc/hosts << EOF
127.0.0.1   localhost
::1         localhost
127.0.1.1   \${HOSTNAME}.localdomain \${HOSTNAME}
EOF

# OS identity
cat > /etc/os-release << EOF
NAME="OmidenOs"
PRETTY_NAME="OmidenOs"
ID=omidenos
ID_LIKE=arch
BUILD_ID=rolling
HOME_URL="https://github.com/muhemmed0634/OmidenOs"
SUPPORT_URL="https://github.com/muhemmed0634/OmidenOs/issues"
BUG_REPORT_URL="https://github.com/muhemmed0634/OmidenOs/issues"
LOGO="omidenos"
EOF

# Users
if [[ -n "\${ROOT_PASS}" ]]; then
    echo "root:\${ROOT_PASS}" | chpasswd
else
    passwd -l root
fi

useradd -m -G wheel,audio,video,storage,optical,network,input \\
    -s /bin/zsh "\${USERNAME}"
echo "\${USERNAME}:\${USER_PASS}" | chpasswd
echo "%wheel ALL=(ALL:ALL) ALL" >> /etc/sudoers

# Initramfs
mkinitcpio -P

# Services
systemctl enable NetworkManager
systemctl enable acpid
systemctl enable bluetooth 2>/dev/null || true

if [[ "\${INSTALL_DESKTOP}" == true ]]; then
    systemctl enable lightdm

    # LightDM autologin
    mkdir -p /etc/lightdm
    cat > /etc/lightdm/lightdm.conf << EOF
[Seat:*]
greeter-session=lightdm-gtk-greeter
user-session=openbox
autologin-user=\${USERNAME}
autologin-user-timeout=0
autologin-session=openbox

[LightDM]
logind-check-graphical=true
EOF

    groupadd -r autologin 2>/dev/null || true
    gpasswd -a "\${USERNAME}" autologin

    # LightDM greeter
    cat > /etc/lightdm/lightdm-gtk-greeter.conf << EOF
[greeter]
background=/usr/share/wallpapers/omiden/omiden-wallpaper.png
theme-name=adw-gtk3-dark
icon-theme-name=Papirus-Dark
font-name=Noto Sans 11
indicators=~host;~spacer;~clock;~spacer;~session;~language;~a11y;~power
clock-format=%H:%M
position=50%,center 50%,center
panel-position=bottom
EOF
fi

# BlackArch
if [[ "\${INSTALL_BLACKARCH}" == true ]]; then
    curl -sO https://blackarch.org/strap.sh
    if echo "5ea40d49ecd14c2e024deecf90605426db97ea0c  strap.sh" | sha1sum -c 2>/dev/null; then
        chmod +x strap.sh && ./strap.sh && rm -f strap.sh
    else
        echo "BlackArch strap checksum failed, skipping."
    fi
    rm -f strap.sh
fi

# Bootloader
if [[ "\${BOOT_MODE}" == "UEFI" ]]; then
    grub-install --target=x86_64-efi --efi-directory=/boot/efi \\
                 --bootloader-id=OmidenOs --recheck
else
    grub-install --target=i386-pc --recheck "\${DISK}"
fi

# GRUB config
sed -i 's/GRUB_TIMEOUT=5/GRUB_TIMEOUT=3/' /etc/default/grub
sed -i 's/#GRUB_DISABLE_OS_PROBER=false/GRUB_DISABLE_OS_PROBER=false/' /etc/default/grub
echo 'GRUB_DISTRIBUTOR="OmidenOs"' >> /etc/default/grub
grub-mkconfig -o /boot/grub/grub.cfg

# Cleanup
rm -f /tmp/omiden-chroot.sh
CHROOT_SCRIPT

    chmod +x /mnt/tmp/omiden-chroot.sh
    arch-chroot /mnt /tmp/omiden-chroot.sh
    info "System configuration complete."
}

# ─── Post Install ─────────────────────────────────────────────
post_install() {
    step "Installation Complete!"
    echo -e "${G}${BOLD}"
    echo "  ╔════════════════════════════════════════╗"
    echo "  ║   OmidenOs installed successfully!     ║"
    echo "  ╚════════════════════════════════════════╝"
    echo -e "${N}"
    echo -e "  ${W}Disk:${N}     $DISK"
    echo -e "  ${W}Hostname:${N} $HOSTNAME"
    echo -e "  ${W}User:${N}     $USERNAME"
    echo -e "  ${W}Boot:${N}     $BOOT_MODE"
    echo ""
    echo -e "  ${C}Next steps:${N}"
    echo -e "  1. Remove the USB/live media"
    echo -e "  2. Reboot"
    echo -e "  3. Log in as ${BOLD}$USERNAME${N}"
    echo ""

    if confirm "Unmount and reboot now?"; then
        umount -R /mnt 2>/dev/null || true
        reboot
    else
        info "Reboot manually when ready:"
        echo -e "  ${BOLD}umount -R /mnt && reboot${N}"
    fi
}

# ─── Main ─────────────────────────────────────────────────────
main() {
    banner
    check_root
    check_uefi
    check_internet
    update_mirrors
    gather_config
    select_disk
    select_filesystem
    partition_disk
    install_base
    copy_configs
    configure_chroot
    post_install
}

main "$@"
