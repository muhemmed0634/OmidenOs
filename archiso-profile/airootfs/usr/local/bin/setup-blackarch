#!/bin/bash
# OmidenOs - BlackArch Repository Setup
set -e

G='\033[0;32m' R='\033[0;31m' Y='\033[1;33m' C='\033[0;36m' N='\033[0m'

# Root check
if [[ $EUID -ne 0 ]]; then
    echo -e "${R}[ERROR]${N} Must be run as root: sudo setup-blackarch"
    exit 1
fi

echo -e "${C}[OmidenOs] Setting up BlackArch repository...${N}"

# Download strap and verify checksum from blackarch.org
curl -O https://blackarch.org/strap.sh

# Try to get the official checksum
if curl -sO https://blackarch.org/strap.sh.sha1sum 2>/dev/null && \
   sha1sum -c strap.sh.sha1sum 2>/dev/null; then
    echo -e "${G}[OK] Checksum verified.${N}"
elif echo "5ea40d49ecd14c2e024deecf90605426db97ea0c  strap.sh" | sha1sum -c 2>/dev/null; then
    echo -e "${Y}[!] Used fallback checksum.${N}"
else
    echo -e "${R}[ERROR] Checksum mismatch! Aborting.${N}"
    rm -f strap.sh strap.sh.sha1sum
    exit 1
fi

chmod +x strap.sh
./strap.sh
rm -f strap.sh strap.sh.sha1sum

pacman -Syy --noconfirm

echo -e "${G}[OK] BlackArch repository added successfully.${N}"
echo -e "${C}Install a tool: pacman -S <tool-name>${N}"
echo -e "${C}Install a category: pacman -S blackarch-recon${N}"
