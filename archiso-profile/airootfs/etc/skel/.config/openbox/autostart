#!/bin/bash
# OmidenOs Openbox Autostart

# Set random wallpaper from wallpapers dir
WALLPAPER_DIR="/usr/share/wallpapers/omiden"
RANDOM_WALL=$(find "$WALLPAPER_DIR" -maxdepth 1 \( -name "*.png" -o -name "*.jpg" -o -name "*.jpeg" \) 2>/dev/null | shuf -n1)
if [[ -n "$RANDOM_WALL" ]]; then
    feh --bg-fill "$RANDOM_WALL" &
else
    feh --bg-fill "$WALLPAPER_DIR/omiden-wallpaper.png" &
fi

# Compositor (picom — no --daemon flag in modern versions)
picom &

# Panel
tint2 &

# Notification daemon
dunst &

# Network Manager applet
nm-applet &

# Polkit agent
/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &

# Welcome screen (slight delay so desktop loads first)
sleep 2 && omiden-welcome &
