/* OmidenOS - Rofi Theme */

* {
    bg:             #0d0d1aee;
    bg-alt:         #1a1a2eee;
    fg:             #cdd6f4;
    fg-alt:         #888888;
    accent:         #e94560;
    accent-alt:     #c0325a;
    urgent:         #f38ba8;
    border:         #e9456040;

    background-color:   transparent;
    text-color:         @fg;
}

window {
    background-color:   @bg;
    border:             2px solid;
    border-color:       @accent;
    border-radius:      12px;
    width:              520px;
    padding:            0;
}

mainbox {
    background-color:   transparent;
    children:           [ inputbar, listview ];
    spacing:            0;
    padding:            12px;
}

inputbar {
    background-color:   @bg-alt;
    border-radius:      8px;
    padding:            10px 14px;
    margin:             0 0 10px 0;
    children:           [ prompt, entry ];
    spacing:            8px;
}

prompt {
    text-color:     @accent;
    font:           "Font Awesome 6 Free Solid 12";
}

entry {
    text-color:     @fg;
    placeholder:    "Search applications...";
    placeholder-color: @fg-alt;
}

listview {
    background-color:   transparent;
    columns:            1;
    lines:              8;
    scrollbar:          false;
    spacing:            4px;
}

element {
    background-color:   transparent;
    border-radius:      6px;
    padding:            8px 10px;
    spacing:            10px;
    children:           [ element-icon, element-text ];
}

element-icon {
    size:   20px;
}

element-text {
    text-color:     @fg;
}

element.selected.normal {
    background-color:   @accent;
}

element.selected.normal element-text {
    text-color:     #ffffff;
}

element.urgent {
    text-color:     @urgent;
}
